[Unit]
Description=NewsScraper: RSS feeds and the push to Provenance, every 5 minutes

[Timer]
# Every 5 minutes. Until 2026-11-05 this was hourly at :45, which made the World Headlines
# widget at least an hour behind the feeds it shows, and after each deploy (about six a day) the
# site held no pushed story until the next run. Five minutes is the far end's own cache period
# for the feeds it reads itself (lib/news/feed.ts), so the push is never staler than that.
#
# Stories that extract reads later are not lost to the map: a story whose extraction is newer
# than the far end's cursor is sent again with its event (newsfeed/rail.py, rows_since).
OnCalendar=*:0/5
RandomizedDelaySec=20s
AccuracySec=10s
Persistent=true

[Install]
WantedBy=timers.target
