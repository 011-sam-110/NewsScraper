[Unit]
Description=NewsScraper: scrape Reuters into the store, through a real Chrome window
Documentation=file:///home/sampo/NewsScraper/docs/ARCHITECTURE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/NewsScraper
EnvironmentFile=-%h/.config/newsfeed/newsfeed.env
# Reuters is fetched from inside installed Google Chrome with a visible window: DataDome answers
# Playwright's bundled Chromium, Chrome for Testing and curl with 401. xvfb-run gives that window a
# display of its own, so the run does not depend on someone being logged in, and does not put a
# Chrome window in front of whoever is.
# Reuters is the outlet to be gentle with, because it is the one that can be refused. On
# 2026-09-15 a run that fetched 312 rows in eleven minutes was answered with HTTP 401 on its last
# two sections: DataDome rate-limited the session, not the machine. So this unit is slower and
# shallower than the other four.
#
# --max-pages is a backstop, not the normal stop. A section normally stops at the first listing
# page where the store already holds every story, which is one page once the store is caught up.
# Three pages is 24 stories a section an hour, well above what any Reuters section publishes.
ExecStart=/usr/bin/xvfb-run -a --server-args="-screen 0 1920x1080x24" %h/NewsScraper/.venv/bin/python -m newsfeed scrape --sources reuters --max-pages 3 --delay 3
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
