# NewsScraper pipeline settings for the host machine.
#
# Copy to ~/.config/newsfeed/newsfeed.env and fill in what the stages you run need. Keep it out of
# the checkout: this repo is public. `chmod 600` it once it holds a key.
#
# Every variable is documented in docs/ARCHITECTURE.md section 7.2.

# Where the databases and health.json live. Never a synced folder: file sync corrupts SQLite
# write-ahead logs, and newsfeed/settings.py refuses a OneDrive, Dropbox or Google Drive path.
# Unset means ~/.local/share/newsscraper, or %LOCALAPPDATA%\NewsScraper on Windows.
#NEWSFEED_DATA_DIR=

# The scraping proxy (a rotating residential gateway). Every outlet is read directly first; a
# block (401, 403, 429, 451, 503, a timeout or a refused connection) is tried once more through
# this. Never type it here by hand: deploy/set-news-key.sh reads it hidden, checks it and writes
# it. Unset means no retry.
#NEWS_PROXY_URL=

# Reuters only. A Chrome profile folder to run Reuters in (for example one you signed in to). Its
# cookies stay in that folder; nothing reads or copies them. Unset means a fresh profile each run.
#NEWS_SCRAPER_CHROME_PROFILE=/home/<you>/.local/share/newsscraper/chrome-reuters
# When Reuters' Chrome goes through NEWS_PROXY_URL: off, retry (after a block) or always.
# Default: retry without a profile, off with one, because a signed-in session that jumps
# between exit IPs looks like a stolen one.
#NEWS_SCRAPER_REUTERS_PROXY=

# --- Not read by any stage that is built yet. Listed so the file matches the design. ---

# extract, resolve, cluster (milestones M5 to M7)
#DEEPSEEK_API_KEY=
#NEWSFEED_DAILY_BUDGET_USD=3

# publish (milestone M10). The secret must also be in the box's NEWSFEED_INGEST_SECRETS.
#NEWSFEED_INGEST_URL=https://provenance-online.com/api/ingest/newsfeed
#NEWSFEED_INGEST_SECRET=
#NEWSFEED_DEADMAN_URL=

# health is built: it posts to the agent hub and needs no setting here. Telegram is not used.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
