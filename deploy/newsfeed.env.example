# NewsScraper pipeline settings for the host machine.
#
# Copy to ~/.config/newsfeed/newsfeed.env and fill in what the stages you run need. Keep it out of
# the checkout: this repo is public. `chmod 600` it once it holds a key.
#
# Every variable is documented in docs/ARCHITECTURE.md section 7.2.

# Where the databases and health.json live. Never a synced folder: file sync corrupts SQLite
# write-ahead logs, and newsfeed/settings.py refuses a OneDrive, Dropbox or Google Drive path.
# Unset means ~/.local/share/newsscraper, or %LOCALAPPDATA%\NewsScraper on Windows.
#NEWSFEED_DATA_DIR=

# One proxy for every outlet. Leave unset unless Reuters needs one.
#NEWS_SCRAPER_PROXY=

# --- Not read by any stage that is built yet. Listed so the file matches the design. ---

# extract, resolve, cluster (milestones M5 to M7)
#DEEPSEEK_API_KEY=
#NEWSFEED_DAILY_BUDGET_USD=3

# publish (milestone M10). The secret must also be in the box's NEWSFEED_INGEST_SECRETS.
#NEWSFEED_INGEST_URL=https://provenance-online.com/api/ingest/newsfeed
#NEWSFEED_INGEST_SECRET=
#NEWSFEED_DEADMAN_URL=

# health (milestone M10)
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
