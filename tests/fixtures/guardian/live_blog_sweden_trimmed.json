     "data": {
      "alt": "Social Democrats party leader Magdalena Andersson (L) arrives at the Social Democrats election night watch party in Stockholm, Sweden.",
      "caption": "Social Democrats party leader Magdalena Andersson (L) arrives at the Social Democrats election night watch party in Stockholm, Sweden.",
      "credit": "Photograph: Jonas Ekstromer/TT News Agency/AFP/Getty Images"
